---
// src/layouts/BaseLayout.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Breadcrumbs } from 'astro-breadcrumbs'; // Импортируем крошки
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Принимаем заголовок страницы как аргумент (пропс), чтобы у каждой страницы был свой title
const { pageTitle = SITE_TITLE } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- Хедер теперь живет здесь -->
		<div class="header-fixed">
			<Header />
		</div>

		<!-- Крошки тоже здесь (можно добавить условие, чтобы не показывать на главной) -->
		<div class="breadcrumbs-wrapper">
			<Breadcrumbs />
		</div>

		<!-- А вот СЮДА будет вставляться уникальный контент каждой страницы -->
		<slot />

		<!-- Футер тоже здесь -->
		<div class="footer-container">
			<Footer />
		</div>
	</body>
</html>