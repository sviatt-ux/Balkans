---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  slug: string;
  heroImage?: { src: string; width: number; height: number; format: string };
}

const { title, description, pubDate, updatedDate, slug, heroImage } = Astro.props;

const displayDate = updatedDate ? updatedDate : pubDate;
const formattedDate = displayDate.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="post-card">
  {heroImage && (
    <a href={`/blog/${slug}`} class="post-card__image-link" aria-label={`Читать статью: ${title}`}>
      <img 
        src={heroImage.src} 
        alt={title}
        class="post-card__image"
        loading="lazy"
        width={heroImage.width}
        height={heroImage.height}
      />
    </a>
  )}
  
  <div class="post-card__content">
    <h2 class="post-card__title">{title}</h2>
    <p class="post-card__description">{description}</p>
    <time class="post-card__date" datetime={displayDate.toISOString()}>
      Обновлено: {formattedDate}
    </time>
    <a href={`/blog/${slug}`} class="post-card__button">Читать полностью</a>
  </div>
</article>

<style>
  /* 🎯 СТИЛЬ ВАРЛАМОВА: БЕЗ РАМОК, БЕЗ ТЕНЕЙ, БЕЗ HOVER НА КАРТОЧКУ */
  .post-card {
    display: flex;
    flex-direction: column;
    background-color: transparent; /* Прозрачный фон, как у Варламова */
    border-radius: 0;
    overflow: visible;
    border: none; /* Убираем рамку */
    box-shadow: none; /* Убираем тень */
  }

  .post-card__image-link {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px; /* Закруглённые углы у фото, как у Варламова */
    background-color: #f0f0f0;
    cursor: pointer;
    margin-bottom: 1rem;
  }

  .post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-card__content {
    padding: 0;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .post-card__title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #111;
    margin: 0 0 1rem 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-card__description {
    font-size: 1rem;
    color: #333;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .post-card__date {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1.5rem;
  }

  /* 🎯 ТВОЯ ОРАНЖЕВАЯ КНОПКА */
  .post-card__button {
    display: inline-block;
    background-color: #FF6B35;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
    cursor: pointer;
    border: none;
    transition: background-color 0.15s ease, transform 0.1s ease, box-shadow 0.15s ease;
    box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
    align-self: flex-start;
  }

  .post-card__button:hover {
    background-color: #e55a2b;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(255, 107, 53, 0.4);
  }

  .post-card__button:active {
    transform: translateY(0);
  }
</style>