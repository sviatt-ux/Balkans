---
// 🎯 Социальные сети (те же что в хедере)
const socialLinks = [
	{
		name: 'YouTube',
		url: 'https://youtube.com',
		path: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z'
	},
	{
		name: 'Telegram',
		url: 'https://t.me/',
		path: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
	},
	{
		name: 'Instagram',
		url: 'https://instagram.com/',
		path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.667.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z'
	},
	{
		name: 'TikTok',
		url: 'https://tiktok.com/',
		path: 'M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.54v-3.4a4.85 4.85 0 0 1-1.04-.12z'
	}
];

// 🎯 Навигация для футера
const footerNav = [
	{ name: 'Главная', url: '/' },
	{ name: 'Маршруты', url: '/routes' },
	{ name: 'Страны', url: '/countries' },
	{ name: 'Блог', url: '/blog' },
	{ name: 'О нас', url: '/about' }
];

// 🎯 Популярные направления (для контекста сайта про Балканы)
const popularDestinations = [
	{ name: 'Хорватия', url: '/countries/croatia' },
	{ name: 'Черногория', url: '/countries/montenegro' },
	{ name: 'Албания', url: '/countries/albania' },
	{ name: 'Босния и Герцеговина', url: '/countries/bosnia' }
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<!-- 🎯 ВЕРХНЯЯ ЧАСТЬ: 4 колонки -->
		<div class="footer-top">
			
			<!-- Колонка 1: О проекте -->
			<div class="footer-col footer-about">
				<h3 class="footer-logo">Балканы без авто</h3>
				<p class="footer-description">
					Аутентичные путешествия по Балканам на общественном транспорте. Маршруты, лайфхаки и вдохновение для тех, кто хочет увидеть настоящий дух региона.
				</p>
				
				<!-- Социальные иконки -->
				<div class="footer-socials">
					{socialLinks.map(social => (
						<a href={social.url} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label={social.name}>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
								<path d={social.path} />
							</svg>
						</a>
					))}
				</div>
			</div>

			<!-- Колонка 2: Навигация -->
			<div class="footer-col">
				<h4 class="footer-heading">Навигация</h4>
				<ul class="footer-links">
					{footerNav.map(link => (
						<li><a href={link.url} class="footer-link">{link.name}</a></li>
					))}
				</ul>
			</div>

			<!-- Колонка 3: Популярные направления -->
			<div class="footer-col">
				<h4 class="footer-heading">Популярные направления</h4>
				<ul class="footer-links">
					{popularDestinations.map(dest => (
						<li><a href={dest.url} class="footer-link">{dest.name}</a></li>
					))}
				</ul>
			</div>

			<!-- Колонка 4: Подписка на email -->
			<div class="footer-col footer-subscribe">
				<h4 class="footer-heading">Подписка на новые статьи</h4>
				<p class="footer-subscribe-text">
					Получай свежие маршруты и лайфхаки прямо на почту. Без спама, только полезный контент!
				</p>
				<form class="subscribe-form" action="/subscribe" method="post">
					<input 
						type="email" 
						name="email" 
						placeholder="Твой email" 
						class="subscribe-input"
						required
						aria-label="Email для подписки"
					/>
					<button type="submit" class="subscribe-btn">
						Подписаться
					</button>
				</form>
			</div>
		</div>

		<!-- 🎯 НИЖНЯЯ ЧАСТЬ: Копирайт и доп. ссылки -->
		<div class="footer-bottom">
			<div class="footer-bottom-inner">
				<p class="copyright">
					© 2024 Балканы без авто. Все права защищены.
				</p>
				<ul class="footer-legal">
					<li><a href="/privacy" class="footer-legal-link">Политика конфиденциальности</a></li>
					<li><a href="/terms" class="footer-legal-link">Условия использования</a></li>
					<li><a href="/contact" class="footer-legal-link">Контакты</a></li>
				</ul>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background-color: #1a1a1a; /* 🎯 Тёмный футер для контраста с белым хедером */
		color: #e0e0e0;
		padding: 4rem 0 0 0;
		margin-top: 0;
	}

	.footer-inner {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.footer-top {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
	}

	.footer-logo {
		font-size: 1.5rem;
		font-weight: 800;
		color: #ffffff;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}

	.footer-description {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #b0b0b0;
		margin-bottom: 1.5rem;
		max-width: 320px;
	}

	/* 🎯 Социальные иконки (чуть больше чем в хедере) */
	.footer-socials {
		display: flex;
		gap: 1rem;
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background-color: rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		color: #e0e0e0;
		transition: all 0.2s ease;
	}

	.social-icon:hover {
		background-color: #FF6B35; /* 🎯 Оранжевый при наведении */
		color: #ffffff;
		transform: translateY(-2px);
	}

	.footer-heading {
		font-size: 1.1rem;
		font-weight: 700;
		color: #ffffff;
		margin-bottom: 1.25rem;
		letter-spacing: -0.01em;
	}

	.footer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-link {
		text-decoration: none;
		color: #b0b0b0;
		font-size: 0.95rem;
		transition: color 0.15s ease;
	}

	.footer-link:hover {
		color: #FF6B35; /* 🎯 Оранжевый при наведении */
	}

	/* 🎯 Форма подписки — железобетонная ширина */
.subscribe-form {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	width: 100%;
	max-width: 100%;
}

.subscribe-input {
	width: 100%;
	min-width: 0; /* 🎯 Ключевое: позволяет сжиматься в flex */
	box-sizing: border-box;
	padding: 0.85rem 1rem;
	background-color: rgba(255, 255, 255, 0.08);
	border: 1px solid rgba(255, 255, 255, 0.15);
	border-radius: 8px;
	color: #ffffff;
	font-size: 0.95rem;
	outline: none;
	transition: all 0.2s ease;
}

.subscribe-input::placeholder {
	color: #888;
}

.subscribe-input:focus {
	border-color: #FF6B35;
	background-color: rgba(255, 255, 255, 0.12);
}

.subscribe-btn {
	width: 100%;
	min-width: 0; /* 🎯 То же самое для кнопки */
	box-sizing: border-box;
	padding: 0.85rem 1.5rem;
	background-color: #FF6B35;
	color: #ffffff;
	border: none;
	border-radius: 8px;
	font-size: 0.95rem;
	font-weight: 700;
	cursor: pointer;
	transition: all 0.2s ease;
	white-space: nowrap;
}

.subscribe-btn:hover {
	background-color: #e55a2b;
	transform: translateY(-1px);
}

.subscribe-btn:active {
	transform: translateY(0);
}

	/* 🎯 Нижняя часть футера */
	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding: 2rem 0;
	}

	.footer-bottom-inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		text-align: center;
	}

	.copyright {
		font-size: 0.9rem;
		color: #888;
		margin: 0;
	}

	.footer-legal {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.footer-legal-link {
		text-decoration: none;
		color: #888;
		font-size: 0.9rem;
		transition: color 0.15s ease;
	}

	.footer-legal-link:hover {
		color: #FF6B35;
	}

	/* 🎯 Адаптивность: планшет */
	@media (min-width: 768px) {
		.footer-top {
			grid-template-columns: repeat(2, 1fr);
		}

		.footer-bottom-inner {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}

		.footer-legal {
			justify-content: flex-end;
		}
	}

	/* 🎯 Адаптивность: десктоп */
	@media (min-width: 1024px) {
		.footer-top {
			grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
		}

		.site-footer {
			padding: 5rem 0 0 0;
		}
	}
</style>