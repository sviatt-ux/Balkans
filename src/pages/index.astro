---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const SITE_TITLE = 'Балканы без авто';
const SITE_DESCRIPTION = 'Аутентичные путешествия по Балканам на общественном транспорте. Маршруты, лайфхаки и вдохновение.';

// 🎯 ИМПОРТИРУЕМ КАРТИНКУ ЧЕРЕЗ ASTRO
import heroImage from '../assets/hero.jpg';
import { getImage } from 'astro:assets';

// 🚀 Генерируем оптимизированную версию
const optimizedHero = await getImage({
	src: heroImage,
	width: 1920,
	quality: 80,
	format: 'webp',
});

const heroBgUrl = optimizedHero.src;
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preload" as="image" href={heroBgUrl} fetchpriority="high" />
	</head>
	<body>
		
		<!-- 🎯 Отдельный fixed-слой для фона hero (не исчезает при ESC) -->
		<div class="hero-bg" style={`background-image: url('${heroBgUrl}')`} aria-hidden="true"></div>

		<!-- 1. ХЕДЕР -->
		<Header />

		<!-- 2. HERO-СЕКЦИЯ -->
		<section class="hero">
			<div class="hero__content">
				<h1 class="hero__title">Открой Балканы по-настоящему.<br>Без машины. Без спешки. Без границ.</h1>
				<p class="hero__subtitle">
					Аутентичные маршруты, скрытые жемчужины и полная свобода передвижения на автобусах, поездах и паромах. Твоё приключение начинается здесь.
				</p>
				<a href="/routes" class="hero__button">Выбрать маршрут</a>
			</div>
		</section>

		<!-- 3. БЕЛЫЙ КОНТЕНТ -->
		<main class="content">
			<div class="content-inner">
				<h2>Почему без авто?</h2>
				<p>
					Забудь о стрессе от парковки в узких улочках Дубровника и бесконечных пробках на побережье. 
					Настоящая душа Балкан раскрывается не из окна арендованной машины, а в ритме местных кафе, 
					в разговорах с попутчиками в старинных поездах и в неожиданных остановках у живописных бухт, 
					куда не ведёт ни один навигатор.
				</p>
				<p>
					Мы доказали: путешествовать по Хорватии, Черногории, Албании и Боснии на общественном транспорте 
					не только возможно, но и в разы интереснее, дешевле и экологичнее. Присоединяйся к движению!
				</p>
			</div>
		</main>

		<!-- 4. ФУТЕР -->
		<div class="footer-container">
			<Footer />
		</div>
	</body>
</html>

<style>
	:global(html), :global(body) {
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100%;
		overflow-x: hidden;
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
	}

	:global(*), :global(*::before), :global(*::after) {
		box-sizing: border-box;
	}

	:global(body) {
		background-color: #f4f4f4;
	}

	/* 🎯 Fixed-слой для фона hero — не исчезает при ESC */
	:global(.hero-bg) {
		position: fixed;
		inset: 0;
		z-index: -1;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		pointer-events: none;
	}

	.hero {
		min-height: calc(100vh - 70px);
		padding-top: 70px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		width: 100%;
	}

	.hero__content {
		max-width: 900px;
		padding: 2rem;
		width: 100%;
	}

	.hero__title {
		font-size: clamp(2.2rem, 6vw, 4.5rem);
		font-weight: 800;
		color: #ffffff;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		text-shadow: 0 4px 12px rgba(0, 0, 0, 0.4);
		letter-spacing: -0.02em;
	}

	.hero__subtitle {
		font-size: clamp(1.1rem, 2.5vw, 1.5rem);
		color: #f0f0f0;
		margin-bottom: 2rem;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero__button {
		display: inline-block;
		background-color: #FF6B35;
		color: #ffffff;
		padding: 1rem 2.5rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 700;
		font-size: 1.1rem;
		margin-top: 1rem;
		box-shadow: 0 4px 14px rgba(255, 107, 53, 0.4);
		transition: transform 0.1s ease, background-color 0.15s ease, box-shadow 0.15s ease;
	}
	.hero__button:hover {
		background-color: #e55a2b;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(255, 107, 53, 0.5);
	}
	.hero__button:active { transform: translateY(0); }

	.content {
		position: relative;
		z-index: 10;
		background-color: #ffffff;
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 5rem 0 6rem;
		box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
	}

	.content-inner {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.content h2 {
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		font-weight: 800;
		margin-bottom: 1.5rem;
		color: #111;
		letter-spacing: -0.01em;
	}

	.content p {
		font-size: 1.15rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
		color: #444;
	}

	.footer-container {
		position: relative;
		z-index: 10;
		background-color: #f9f9f9;
		border-top: 1px solid #eee;
		width: 100%;
	}

	@media (max-width: 768px) {
		.hero {
			min-height: 100svh;
			padding-top: 70px;
		}
		.hero__content { padding: 1.5rem; }
	}
</style>