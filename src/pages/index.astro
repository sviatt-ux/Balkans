---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 🎯 ИМПОРТИРУЕМ КАРТИНКУ ЧЕРЕЗ ASTRO — теперь он её ВИДИТ и оптимизирует!
import heroImage from '../assets/hero.jpg';
import { getImage } from 'astro:assets';

// 🚀 Генерируем оптимизированную версию (WebP/AVIF + правильный размер)
const optimizedHero = await getImage({
	src: heroImage,
	width: 1920,
	quality: 80,
	format: 'webp', // или 'avif' — ещё круче, но WebP универсальнее
});

// URL оптимизированной картинки — сунем его в CSS
const heroBgUrl = optimizedHero.src;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<!-- ⚡ PRELOAD — браузер начнёт грузить картинку ДО того, как увидит CSS -->
		<link rel="preload" as="image" href={heroBgUrl} fetchpriority="high" />
	</head>
	<body style={`--hero-bg: url('${heroBgUrl}')`}>
		<!-- 1. ХЕДЕР (ЖЁСТКО ФИКСИРОВАННЫЙ) -->
		<div class="header-fixed">
			<Header />
		</div>

		<!-- 2. HERO-СЕКЦИЯ (ТЕКСТ) -->
		<section class="hero">
			<div class="hero__content">
				<h1 class="hero__title">A better internet for everyone is possible.<br>Today.</h1>
				<p class="hero__subtitle">
					How do we build social media that strengthens democratic discourse and is both resilient and appealing?
				</p>
				<p class="hero__subtitle">The Open Social Web Alliance aims to provide the answers.</p>
				<a href="#" class="hero__button">Read the policy paper (PDF)</a>
			</div>
		</section>

		<!-- 3. БЕЛЫЙ КОНТЕНТ -->
		<main class="content">
			<div class="content-inner">
				<h2>The Vision</h2>
				<p>
					A shared, standardised communication protocol: it may sound technically complicated,
					but it is as simple as it is brilliant, and the technical blueprint has long been familiar to
					all of us: email. Whether your address is hosted by Proton, Posteo, Gmail or GMX, your
					digital letters reach their destination. This is the idea we build on.
				</p>
				<p>
					The year is 2028. Thanks to smart investment and political foresight, the Open Social
					Web Alliance has successfully established a standard that allows users to communicate
					across platforms seamlessly.
				</p>
			</div>
		</main>

		<!-- 4. ФУТЕР -->
		<div class="footer-container">
			<Footer />
		</div>
	</body>
</html>

<style>
	/* --- ГЛОБАЛЬНЫЙ СБРОС --- */
	:global(html), :global(body) {
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100%;
	}

	:global(body) {
		/* 🎯 Берём URL из CSS-переменной, которую мы задали в <body style> */
		background-image: var(--hero-bg);
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
		background-repeat: no-repeat;
		background-color: #f4f4f4;
	}

	/* --- 1. ХЕДЕР --- */
	.header-fixed {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 1000;
		background-color: #ffffff;
		border-bottom: 1px solid #eee;
	}

	/* --- 2. HERO-СЕКЦИЯ --- */
	.hero {
		min-height: calc(100vh - 80px);
		padding-top: 80px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.hero__content {
		max-width: 900px;
		padding: 2rem;
	}

	.hero__title {
		font-size: clamp(2rem, 5vw, 4.5rem);
		font-weight: 700;
		color: #111;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		text-shadow: 0 2px 10px rgba(255, 255, 255, 0.8);
	}

	.hero__subtitle {
		font-size: clamp(1rem, 2vw, 1.4rem);
		color: #333;
		margin-bottom: 1rem;
		text-shadow: 0 1px 5px rgba(255, 255, 255, 0.8);
	}

	.hero__button {
		display: inline-block;
		background-color: #fbc02d;
		color: #111;
		padding: 1rem 2rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 700;
		margin-top: 2rem;
		box-shadow: 0 4px 6px rgba(0,0,0,0.1);
	}

	/* --- 3. БЕЛЫЙ КОНТЕНТ --- */
	.content {
		position: relative;
		z-index: 10;
		background-color: #ffffff;
		width: 100vw;
		max-width: 100%;
		margin: 0;
		padding: 4rem 0 8rem;
		box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.1);
		min-height: 100vh;
	}

	.content-inner {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.content h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1.5rem;
	}

	.content p {
		font-size: 1.15rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}

	/* --- 4. ФУТЕР --- */
	.footer-container {
		position: relative;
		z-index: 10;
		background-color: #f9f9f9;
		border-top: 1px solid #eee;
		width: 100%;
	}

	/* --- 5. АДАПТИВ --- */
	@media (max-width: 768px) {
		.hero {
			min-height: 100svh;
			padding-top: 70px;
		}
	}
</style>