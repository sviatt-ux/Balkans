---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';

const SITE_TITLE = 'Блог | Балканы без авто';
const SITE_DESCRIPTION = 'Все статьи, маршруты и лайфхаки о путешествиях по Балканам на общественном транспорте.';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <!-- 🎯 ЗАМЕНИЛИ <main> НА <div>, ЧТОБЫ ИЗБЕЖАТЬ КОНФЛИКТА С global.css -->
    <div class="blog-page">
      <div class="blog-inner">
        <h1 class="blog-title">Блог</h1>
        <p class="blog-subtitle">
          Истории, маршруты и лайфхаки для путешествий по Балканам без автомобиля.
        </p>

        {sortedPosts.length === 0 ? (
          <p class="empty-message">Пока нет статей. Загляните позже!</p>
        ) : (
          <div class="posts-grid">
            {sortedPosts.map(post => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                updatedDate={post.data.updatedDate}
                slug={post.slug}
                heroImage={post.data.heroImage}
              />
            ))}
          </div>
        )}
      </div>
    </div>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .blog-page {
    padding-top: 100px;
    padding-bottom: 5rem;
    background-color: #ffffff;
    min-height: 100vh;
    width: 100%; /* 🎯 НА ВСЮ ШИРИНУ! */
  }

  .blog-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  .blog-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: #111;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .blog-subtitle {
    font-size: 1.15rem;
    color: #555;
    margin: 0 0 3rem 0;
    max-width: 600px;
  }

  .empty-message {
    font-size: 1.1rem;
    color: #888;
    text-align: center;
    padding: 3rem 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2.5rem;
  }

  @media (max-width: 1024px) {
    .blog-inner {
      padding: 0 1.5rem;
    }
    .posts-grid {
      gap: 2.5rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .blog-inner {
      padding: 0 1rem;
    }
    .posts-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .blog-page {
      padding-top: 90px;
      padding-bottom: 3rem;
    }
    .blog-subtitle {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 375px) {
    .blog-inner {
      padding: 0 0.75rem;
    }
  }
</style>